---
import { withBase } from "@/utils/withBase";
import ui from "@/ui";

type Props = {
  current: string;
  parents?: { label: string; href: string }[];
};

const { current, parents = [] } = Astro.props;
const links = [{ label: ui.nav.home, href: withBase("") }, ...parents];
---

<nav class="app-layout mt-8 mb-1" aria-label="breadcrumb">
  <ul
    class="flex flex-wrap items-center gap-x-1 font-light [&>li>a]:hover:opacity-100"
  >
    {
      links.map(({ label, href }) => (
        <li class="flex items-center gap-x-1">
          <a href={href} class="opacity-80">{label}</a>
          <span aria-hidden="true" class="opacity-80">&raquo;</span>
        </li>
      ))
    }
    <li>
      <span class="opacity-75" aria-current="page">{current}</span>
    </li>
  </ul>
</nav>
