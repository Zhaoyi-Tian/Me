---
import type { HTMLAttributes } from "astro/types";
import Socials from "./Socials.astro";
import config from "@/astro-paper.config";

type Props = {
  noMarginTop?: boolean;
  /** 首页介绍区已有同一组社交链接时隐藏。 */
  hideSocials?: boolean;
} & HTMLAttributes<"footer">;

const {
  noMarginTop = false,
  hideSocials = false,
  class: className,
  ...attrs
} = Astro.props;

const currentYear = new Date().getFullYear();
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div
    class="border-border flex flex-col-reverse items-center justify-between border-t py-6 sm:flex-row sm:py-4"
  >
    <span class="my-2 whitespace-nowrap">
      &#169; {currentYear} {config.site.author}
    </span>
    {!hideSocials && <Socials />}
  </div>
</footer>
