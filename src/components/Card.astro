---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostUrl";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", data } = Astro.props;

const { slug, title, description, pubDatetime } = data;
---

<li class="my-6">
  <a
    href={getPostUrl(slug)}
    class:list={[
      "text-accent inline-block text-lg font-medium",
      "decoration-dashed underline-offset-4 hover:underline",
      "focus-visible:no-underline focus-visible:underline-offset-0",
    ]}
  >
    <Heading transition:name={`post-${slug}`}>
      {title}
    </Heading>
  </a>
  <Datetime {pubDatetime} />
  <p>{description}</p>
</li>
