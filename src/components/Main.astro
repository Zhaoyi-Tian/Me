---
type Props = {
  pageTitle: string;
  pageDesc?: string;
  class?: string;
};

const { pageTitle, pageDesc, class: className } = Astro.props;
---

<main
  id="main-content"
  class:list={["app-layout pb-4", className]}
>
  <header class="mb-6">
    <h1 class="text-2xl font-semibold sm:text-3xl">{pageTitle}</h1>
    {pageDesc && <p class="mt-2 italic">{pageDesc}</p>}
  </header>
  <slot />
</main>
