---
interface Props {
  period: string;
  title: string;
}

const { period, title } = Astro.props;
---

<div class="about-entry not-prose">
  <p class="entry-period">{period}</p>
  <div>
    <p class="entry-title">{title}</p>
    <div class="entry-description"><slot /></div>
  </div>
</div>

<style>
  .about-entry {
    display: grid;
    gap: 0.25rem;
    margin-block: 1rem;
    line-height: 1.7;
  }

  .entry-period {
    margin: 0;
    padding-top: 0.125rem;
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    opacity: 0.65;
  }

  .entry-title {
    margin: 0;
    font-weight: 600;
  }

  .entry-description {
    margin-top: 0.25rem;
  }

  .entry-description :global(p + p) {
    margin-top: 0.5rem;
  }

  @media (min-width: 640px) {
    .about-entry {
      grid-template-columns: 9rem minmax(0, 1fr);
      gap: 1.5rem;
    }
  }
</style>
