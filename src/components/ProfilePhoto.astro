---
import { Image } from "astro:assets";
import portrait from "@/assets/images/profile.jpg";
import paperclip from "@/assets/images/paperclip.webp";
---

<figure class="profile-photo">
  <div class="photo-paper">
    <Image
      src={portrait}
      alt="Zhaoyi Tian smiling by the sea and making a peace sign."
      width={360}
      widths={[180, 360, 540]}
      sizes="(min-width: 640px) 178px, 146px"
      format="webp"
      quality={85}
      loading="eager"
    />
  </div>

  <!-- 透明图层包含回形针与阴影；照片仍单独渲染。 -->
  <img
    class="paperclip"
    src={paperclip.src}
    width={paperclip.width}
    height={paperclip.height}
    alt=""
    decoding="async"
  />
</figure>

<style>
  .profile-photo {
    position: relative;
    width: 10rem;
    margin: 0;
    transform: rotate(1.5deg);
  }

  .photo-paper {
    padding: 6px 6px 15px;
    border: 1px solid rgb(52 57 63 / 8%);
    border-radius: 2px;
    background: #faf9f6;
    box-shadow:
      0 1px 2px rgb(24 32 40 / 13%),
      1px 7px 13px -8px rgb(24 32 40 / 30%);
  }

  .photo-paper img {
    display: block;
    width: 100%;
    height: auto;
  }

  .paperclip {
    position: absolute;
    /* 图层内的纸顶位于第 16px，对齐相纸上沿。 */
    top: -16px;
    right: 5px;
    width: 48px;
    height: auto;
    pointer-events: none;
  }

  :global([data-theme="dark"]) .photo-paper {
    background: #e7e5df;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 20%),
      1px 7px 13px -8px rgb(0 0 0 / 50%);
  }

  @media (min-width: 640px) {
    .profile-photo {
      width: 12rem;
    }
  }
</style>
