---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/astro-paper.config";

const about = await getEntry("pages", "about");

if (!about) {
  throw new Error(
    "Missing content entry: `about.md` or `about.mdx` in `src/content/pages/`"
  );
}

const { Content } = await render(about);
---

<Layout
  title={`${about.data.title} | ${config.site.title}`}
  description={about.data.description}
>
  <Header />

  <Breadcrumb />

  <Main pageTitle={about.data.title} class="app-prose">
    <div class="about-content">
      <Content />
    </div>
  </Main>

  <Footer />
</Layout>

<style>
  .about-content :global(h2) {
    margin-top: 2.75rem;
    margin-bottom: 1.25rem;
    font-size: 1.25rem;
    font-weight: 600;
  }

  .about-content :global(h3) {
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
    font-size: 0.875rem;
    font-style: normal;
    font-weight: 600;
    opacity: 0.7;
  }

  .about-content :global(h2 + h3) {
    margin-top: 0;
  }
</style>
