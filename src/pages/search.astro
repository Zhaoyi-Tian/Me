---
import "@pagefind/default-ui/css/ui.css";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { withBase } from "@/utils/withBase";
import { getPosts } from "@/utils/getPosts";
import ui from "@/ui";
import config from "@/astro-paper.config";

const pagefindBundlePath = withBase("pagefind/");
const hasPosts = (await getPosts()).length > 0;
---

<Layout title={`${ui.pages.searchTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb current={ui.pages.searchTitle} />

  <Main pageTitle={ui.pages.searchTitle} pageDesc={ui.pages.searchDesc}>
    {
      hasPosts ? (
        <>
          {import.meta.env.DEV && (
            <p class="mb-4 rounded bg-muted/75 p-4">
              Run <code>npm run build</code> to refresh search results during development.
            </p>
          )}
          <pagefind-search
            id="pagefind-search"
            class="block"
            data-bundle-path={pagefindBundlePath}
          />
        </>
      ) : (
        <p>{ui.pages.noPosts}</p>
      )
    }
  </Main>

  <Footer />
</Layout>

<script>
  class PagefindSearch extends HTMLElement {
    private cleanup?: AbortController;
    private search?: { destroy(): void };

    async connectedCallback() {
      const { signal } = (this.cleanup = new AbortController());
      // @ts-expect-error — Missing types for @pagefind/default-ui package.
      const { PagefindUI } = await import("@pagefind/default-ui");
      if (signal.aborted) return;

      const search = new PagefindUI({
        element: this,
        bundlePath: this.dataset.bundlePath,
        showImages: false,
        showSubResults: true,
      });
      this.search = search;

      const query = new URL(window.location.href).searchParams.get("q");
      if (query) search.triggerSearch(query);

      this.addEventListener("input", event => {
        if (event.target instanceof HTMLInputElement) {
          this.updateQuery(event.target.value);
        }
      }, { signal });
      // Pagefind clears its input without emitting an input event in these cases.
      this.addEventListener("click", event => {
        if (event.target instanceof Element &&
            event.target.closest(".pagefind-ui__search-clear")) {
          this.updateQuery("");
        }
      }, { signal });
      this.addEventListener("keydown", event => {
        if (event.key === "Escape" && event.target instanceof HTMLInputElement) {
          this.updateQuery("");
        }
      }, { signal });
    }

    private updateQuery(term: string) {
      const url = new URL(window.location.href);
      if (term) url.searchParams.set("q", term);
      else url.searchParams.delete("q");
      history.replaceState(history.state, "", url);
    }

    disconnectedCallback() {
      this.cleanup?.abort();
      this.search?.destroy();
      this.search = undefined;
    }
  }

  if (!customElements.get("pagefind-search")) {
    customElements.define("pagefind-search", PagefindSearch);
  }
</script>

<style is:global>
  #pagefind-search {
    --pagefind-ui-font: var(--font-app);
    --pagefind-ui-text: var(--foreground);
    --pagefind-ui-background: var(--background);
    --pagefind-ui-border: var(--border);
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-tag: var(--background);
    --pagefind-ui-border-radius: 0.375rem;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-image-border-radius: 8px;
    --pagefind-ui-image-box-ratio: 3 / 2;

    form::before {
      background-color: var(--foreground);
    }

    input {
      font-weight: 400;
      border: 1px solid var(--border);
    }

    input:focus-visible {
      outline: 1px solid var(--accent);
    }

    .pagefind-ui__result-title a {
      color: var(--accent);
      outline-offset: 1px;
      outline-color: var(--accent);
      text-decoration-style: dashed;
      text-underline-offset: 4px;
    }

    .pagefind-ui__result-title a:focus-visible,
    .pagefind-ui__search-clear:focus-visible {
      text-decoration-line: none;
      outline-width: 2px;
      outline-style: dashed;
    }

    .pagefind-ui__result:last-of-type {
      border-bottom: 0;
    }

    .pagefind-ui__result-nested .pagefind-ui__result-link:before {
      font-family: var(--font-app);
    }
  }
</style>
