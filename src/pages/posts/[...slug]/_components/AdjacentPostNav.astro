---
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { getPostUrl } from "@/utils/getPostUrl";
import ui from "@/ui";

export type AdjacentPost = {
  slug: string;
  title: string;
};

type Props = {
  prevPost: AdjacentPost | null;
  nextPost: AdjacentPost | null;
};

const { prevPost, nextPost } = Astro.props;
---

<div data-pagefind-ignore class="my-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
  {
    prevPost && (
      <a
        href={getPostUrl(prevPost.slug)}
        class="flex w-full gap-1 hover:opacity-75"
      >
        <IconArrowLeft class="inline-block flex-none" />
        <div>
          <span>{ui.post.previousPost}</span>
          <div class="text-accent/85 text-sm">{prevPost.title}</div>
        </div>
      </a>
    )
  }
  {
    nextPost && (
      <a
        href={getPostUrl(nextPost.slug)}
        class="flex w-full justify-end gap-1 text-end hover:opacity-75 sm:col-start-2"
      >
        <div>
          <span>{ui.post.nextPost}</span>
          <div class="text-accent/85 text-sm">{nextPost.title}</div>
        </div>
        <IconArrowRight class="inline-block flex-none" />
      </a>
    )
  }
</div>
