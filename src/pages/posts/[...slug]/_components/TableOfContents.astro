---
// Adapted from Astro Theme Pure's TOC / TOCHeading (Apache-2.0).
// Changes: two heading levels, responsive disclosure, and visible-range indicators.
// Source: https://github.com/cworld1/astro-theme-pure — see licenses/astro-theme-pure.txt.
import type { MarkdownHeading } from "astro";
import { useTranslations } from "@/i18n";

type Props = { headings: MarkdownHeading[] };

const { headings } = Astro.props;
const label = useTranslations(Astro.currentLocale).post.tableOfContents;
---

<post-toc class="not-prose" hidden data-pagefind-ignore>
  <details>
    <summary>{label}</summary>
    <p class="desktop-label">{label}</p>
    <nav aria-label={label}>
      <ul>
        {
          headings.map(({ depth, slug, text }) => (
            <li>
              <a
                href={`#${slug}`}
                data-heading={slug}
                class:list={{ nested: depth === 3 }}
              >
                {text}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </details>
</post-toc>

<script>
  class PostToc extends HTMLElement {
    private cleanup?: AbortController;
    private frame = 0;

    connectedCallback() {
      const article = document.getElementById("article")!;
      const firstLink = this.querySelector<HTMLAnchorElement>("a[data-heading]");
      const firstHeading = document.getElementById(firstLink?.dataset.heading ?? "");
      // 同一份目录放在引言之后；宽屏仅通过 CSS 将它放到页边。
      // 移动会重新触发 connectedCallback，位置就绪后再初始化监听。
      if (firstHeading && this.nextElementSibling !== firstHeading) {
        firstHeading.before(this);
        return;
      }

      this.cleanup = new AbortController();
      const { signal } = this.cleanup;
      const disclosure = this.querySelector("details")!;
      const nav = this.querySelector("nav")!;
      const desktop = window.matchMedia("(min-width: 80rem)");
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const links = Array.from(
        this.querySelectorAll<HTMLAnchorElement>("a[data-heading]")
      );
      const sections = links.flatMap(link => {
        const heading = document.getElementById(link.dataset.heading!);
        return heading ? [{ link, heading }] : [];
      });
      let readingLine = 0;
      let reading = false;
      let followedIndex = -1;

      const update = () => {
        this.frame = 0;
        const rects = sections.map(
          ({ heading }) => heading.getBoundingClientRect()
        );
        const firstTop = rects[0]?.top ?? Infinity;
        const viewportHeight = window.innerHeight;
        const articleBottom = article.getBoundingClientRect().bottom;

        // 第一节越过目录顶边才出现，文末进入视野后退出；回滚留 12px 缓冲。
        reading =
          firstTop <= readingLine + (reading ? 12 : 0) &&
          articleBottom > viewportHeight + (reading ? 0 : 12);
        const visible = !desktop.matches || reading;
        this.toggleAttribute("data-visible", visible);
        this.inert = !visible;

        const activeIndex = rects.findLastIndex(({ top }) => top <= readingLine);

        sections.forEach((section, index) => {
          // 每节从当前标题到下一标题；亮区映射它与屏幕相交的起止比例。
          const top = rects[index].top;
          const bottom = rects[index + 1]?.top ?? articleBottom;
          const height = Math.max(1, bottom - top);
          const start = Math.max(0, Math.min(1, -top / height));
          const end = Math.max(0, Math.min(1, (viewportHeight - top) / height));
          section.link.style.setProperty("--visible-start", `${start * 100}%`);
          section.link.style.setProperty("--visible-end", `${end * 100}%`);
          section.link.toggleAttribute("data-in-view", end > start);
          if (index === activeIndex) {
            section.link.setAttribute("aria-current", "location");
          } else {
            section.link.removeAttribute("aria-current");
          }
        });

        const current = sections[activeIndex]?.link;
        if (!visible) followedIndex = -1;
        // 只在当前项被遮住时滚动列表；外框不动，手动浏览目录时暂停跟随。
        if (
          visible &&
          desktop.matches &&
          current &&
          activeIndex !== followedIndex &&
          !nav.matches(":hover, :focus-within")
        ) {
          followedIndex = activeIndex;
          const item = current.getBoundingClientRect();
          const viewport = nav.getBoundingClientRect();
          let offset = 0;
          if (item.top < viewport.top) {
            offset = item.top - viewport.top - 8;
          } else if (item.bottom > viewport.bottom) {
            offset = item.bottom - viewport.bottom + 8;
          }
          if (offset) {
            nav.scrollBy({
              top: offset,
              behavior: reducedMotion.matches ? "instant" : "smooth",
            });
          }
        }
      };

      const scheduleUpdate = () => {
        if (!this.frame) this.frame = requestAnimationFrame(update);
      };
      const updateLayout = () => {
        readingLine = Number.parseFloat(getComputedStyle(disclosure).top);
        followedIndex = -1;
        scheduleUpdate();
      };

      // 图片加载、字体和正文内折叠内容改变高度时，也重新判断阅读位置。
      const observer = new ResizeObserver(updateLayout);
      observer.observe(article);
      signal.addEventListener("abort", () => observer.disconnect(), { once: true });

      const adapt = () => {
        disclosure.open = desktop.matches;
        reading = false;
        updateLayout();
      };

      this.addEventListener(
        "click",
        event => {
          const link = (event.target as Element).closest("a[data-heading]");
          if (link && !desktop.matches) disclosure.open = false;
        },
        { signal }
      );
      window.addEventListener("scroll", scheduleUpdate, { passive: true, signal });
      window.addEventListener("resize", updateLayout, { signal });
      window.addEventListener("hashchange", scheduleUpdate, { signal });
      desktop.addEventListener("change", adapt, { signal });
      this.hidden = false;
      adapt();
    }

    disconnectedCallback() {
      this.cleanup?.abort();
      cancelAnimationFrame(this.frame);
      this.frame = 0;
    }
  }

  if (!customElements.get("post-toc")) {
    customElements.define("post-toc", PostToc);
  }
</script>

<style>
  post-toc {
    display: block;
    margin-block: 2rem 1.5rem;
    color: var(--muted-foreground);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  post-toc[hidden] {
    display: none;
  }

  details {
    display: block;
    color: inherit;
    cursor: auto;
    user-select: text;
    /* 固定位置与当前章节判定共用这条阅读线。 */
    top: 2rem;
  }

  summary {
    width: fit-content;
    cursor: pointer;
    font-weight: 500;
  }

  .desktop-label {
    display: none;
    margin: 0;
    color: inherit;
    font-weight: 500;
  }

  nav {
    max-height: min(28rem, 65dvh);
    overflow-y: auto;
    overscroll-behavior: contain;
    margin-top: 0.75rem;
    padding: 0.125rem;
    scrollbar-width: thin;
    scrollbar-gutter: stable;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    color: inherit;
  }

  post-toc a {
    position: relative;
    display: block;
    padding: 0.375rem 0.75rem;
    overflow-wrap: anywhere;
    color: inherit;
    text-decoration: none;
    transition: color 300ms ease;
  }

  a::before {
    content: "";
    position: absolute;
    inset-block-start: 5%;
    inset-inline-start: 0;
    width: 2px;
    height: 90%;
    border-radius: 999px;
    background: linear-gradient(
      to bottom,
      var(--border) 0 var(--visible-start, 0%),
      var(--accent) var(--visible-start, 0%) var(--visible-end, 0%),
      var(--border) var(--visible-end, 0%) 100%
    );
    pointer-events: none;
  }

  post-toc a.nested {
    padding-inline-start: 1.5rem;
  }

  post-toc a:hover {
    color: var(--foreground);
  }

  post-toc a[data-in-view] {
    color: var(--accent);
  }

  summary:focus-visible,
  a:focus-visible {
    outline: 2px dashed var(--accent);
    outline-offset: 2px;
  }

  @media (min-width: 80rem) {
    post-toc {
      position: absolute;
      inset-block: 0;
      inset-inline-start: calc(100% + 2rem);
      width: 12rem;
      margin: 0;
      visibility: hidden;
      opacity: 0;
      pointer-events: none;
      transition: opacity 120ms ease-out, visibility 0s linear 120ms;
    }

    post-toc[data-visible] {
      visibility: visible;
      opacity: 1;
      pointer-events: auto;
      transition: opacity 320ms ease-out, visibility 0s;
    }

    details {
      position: fixed;
      width: inherit;
    }

    summary {
      display: none;
    }

    .desktop-label {
      display: block;
    }

    nav {
      max-height: calc(100dvh - 7rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    post-toc,
    post-toc[data-visible],
    post-toc a {
      transition: none;
    }
  }
</style>
