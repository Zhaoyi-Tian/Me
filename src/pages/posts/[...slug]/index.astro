---
import { type CollectionEntry, render } from "astro:content";
import PostLayout from "@/layouts/PostLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";
import Tag from "@/components/Tag.astro";
import { getPosts } from "@/utils/getPosts";
import { slugifyStr } from "@/utils/slugify";
import { toTransitionName } from "@/utils/toTransitionName";
import ShareLinks from "./_components/ShareLinks.astro";
import BackButton from "./_components/BackButton.astro";
import ReadingControls from "./_components/ReadingControls.astro";
import AdjacentPostNav, {
  type AdjacentPost,
} from "./_components/AdjacentPostNav.astro";
import TableOfContents from "./_components/TableOfContents.astro";
import config from "@/config";

export async function getStaticPaths() {
  const posts = await getPosts();

  return posts.map((post, index) => ({
    params: { slug: post.data.slug },
    props: {
      post,
      // posts is newest-first, so "older" (prev) is a higher index
      // and "newer" (next) is a lower index.
      prevPost:
        index < posts.length - 1
          ? {
              slug: posts[index + 1].data.slug,
              title: posts[index + 1].data.title,
            }
          : null,
      nextPost:
        index > 0
          ? {
              slug: posts[index - 1].data.slug,
              title: posts[index - 1].data.title,
            }
          : null,
    },
  }));
}

type Props = {
  post: CollectionEntry<"posts">;
  prevPost: AdjacentPost | null;
  nextPost: AdjacentPost | null;
};

const { post, prevPost, nextPost } = Astro.props;

const {
  title,
  description,
  ogImage: initOgImage,
  pubDatetime,
  tags,
} = post.data;

const { Content, headings } = await render(post);
const tocHeadings = headings.filter(({ depth }) => depth === 2 || depth === 3);
const showToc = tocHeadings.length > 0;

const ogImage = new URL(
  typeof initOgImage === "string" ? initOgImage : initOgImage.src,
  Astro.site ?? Astro.url
).href;
---

<PostLayout
  {title}
  {description}
  {ogImage}
  {pubDatetime}
>
  <Header />

  <BackButton />

  <main
    id="main-content"
    class:list={["app-layout", { "mt-8": !config.features.showBackButton }]}
    data-pagefind-body
  >
    <h1
      style={{ viewTransitionName: toTransitionName(post.data.slug) }}
      class="text-accent inline-block text-2xl font-bold sm:text-3xl"
    >
      {title}
    </h1>

    <Datetime {pubDatetime} size="lg" class="my-2" />

    <div class="relative mt-8">
      {showToc && <TableOfContents headings={tocHeadings} />}
      <article
        id="article"
        class:list={[
          "app-prose max-w-app w-full",
          "prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)",
        ]}
      >
        <article-content class="contents">
          <Content />
        </article-content>
      </article>
    </div>

    <hr class="my-8 border-dashed" />

    <ReadingControls />

    {
      tags.length > 0 && (
        <ul class="mt-4 mb-8 flex flex-wrap gap-4 sm:my-8">
          {tags.map(tag => <Tag tag={slugifyStr(tag)} tagName={tag} size="sm" />)}
        </ul>
      )
    }

    <ShareLinks />

    <hr class="my-8 border-dashed" />

    <AdjacentPostNav {prevPost} {nextPost} />
  </main>
  <Footer />
</PostLayout>

<script>
  import "@/scripts/article";
</script>
