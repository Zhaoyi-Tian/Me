---
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import ProfilePhoto from "@/components/ProfilePhoto.astro";
import { getPosts } from "@/utils/getPosts";
import { withBase } from "@/utils/withBase";
import ui from "@/ui";
import config from "@/astro-paper.config";

const { socials, posts: postsConfig } = config;

const posts = await getPosts();
const featuredPosts = posts.filter(({ data }) => data.featured);
const recentPosts = posts.filter(({ data }) => !data.featured);
---

<Layout>
  <Header />
  <main id="main-content" class="app-layout my-1">
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <div>
        <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
          Zhaoyi Tian
        </h1>

        <p>
          I'm an undergraduate in Intelligent Science and Technology at Peking
          University, interested in continual learning and self-improving agents.
          I hope to build AI that keeps learning through interaction with the
          world.
        </p>
        <p class="mt-2">
          I'm currently interning at Norizon AI, exploring real-time RSI.
        </p>
        <div class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-2">
          {socials.length > 0 && <Socials />}
          <LinkButton
            href={withBase("cv.pdf")}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="View CV (PDF, opens in a new tab)"
            title="CV (PDF)"
            class="text-sm"
          >
            CV
          </LinkButton>
          <LinkButton
            href={withBase("about/")}
            class="text-sm"
          >
            More about me
            <IconArrowRight class="size-4" aria-hidden="true" />
          </LinkButton>
        </div>
      </div>
      <div class="intro-portrait">
        <ProfilePhoto />
      </div>
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            {ui.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(post => (
              <Card variant="h3" data={post.data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {ui.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(post => (
              <Card variant="h3" data={post.data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      posts.length > 0 && (
        <div class="my-8 text-center">
          <LinkButton href={withBase("posts/")}>
            {ui.home.allPosts}
            <IconArrowRight class="inline-block" />
          </LinkButton>
        </div>
      )
    }
  </main>
  <Footer />
</Layout>

<style>
  #hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
  }

  .intro-portrait {
    grid-row: 1;
    margin-top: 0.75rem;
  }

  @media (min-width: 640px) {
    #hero {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      column-gap: 2.5rem;
    }

    .intro-portrait {
      grid-row: auto;
      margin: 1rem 0;
    }
  }
</style>
